# Copy to .env and fill in values. Never commit .env.

# --- AI providers (at least one recommended for structuring) ---
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional future providers
# OPENROUTER_API_KEY=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# Optional local fallback (Ollama)
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2

# --- Defaults ---
DEFAULT_AI_PROVIDER=auto
# Use model IDs from your provider dashboard if these change:
GEMINI_MODEL=gemini-3.8-flash
GROQ_MODEL=openai/gpt-oss-120b

# Failover order for AUTO (comma-separated, configured keys only)
AI_PROVIDER_ORDER=gemini,groq
AI_MAX_ATTEMPTS_PER_PROVIDER=3
AI_RETRY_BASE_SECONDS=1.0
AI_RETRY_MAX_SECONDS=30.0

# --- Upload limits ---
MAX_UPLOAD_SIZE_MB=10
MAX_IMAGE_WIDTH=8000
MAX_IMAGE_HEIGHT=8000
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png

# --- Duplicate detection ---
FINGERPRINT_ENABLED=true

# --- Excel ---
EXCEL_DEFAULT_SHEET=ExtractedData
EXCEL_LINE_ITEMS_SHEET=LineItems

# --- OCR (local PaddleOCR) ---
OCR_LANG=en
PADDLE_USE_GPU=false
